# -*- mode: snippet -*-
# name: makewin
# key: makewin
# expand-env: ((yas-indent-line 'fixed))
# --
CC = cl

BUILD = build
CFLAGS = /W4 /D_CRT_SECURE_NO_WARNINGS /Fo:$(BUILD)\

TARGET = $(BUILD)\$1
SRC = $2

!IF "$(debug)"=="1"
CFLAGS=$(CFLAGS) /Zi /Od
!ELSE
CFLAGS=$(CFLAGS) /O2
!ENDIF

all: $(TARGET) $(BUILD)

$(BUILD):
	if not exist $(BUILD) mkdir $(BUILD)

$(TARGET): $(SRC) $(BUILD)
	$(CC) $(CFLAGS) /Fe:$(TARGET) $(SRC)

clean:
	rmdir /S /Q $(BUILD)

.PHONY: all clean