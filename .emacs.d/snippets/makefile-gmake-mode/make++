# -*- mode: snippet -*-
# name: make++
# key: make++
# expand-env: ((yas-indent-line 'fixed))
# --
CXX = g++
CXXFLAGS = -Wall -Wextra

BUILD = build
TARGET = $(BUILD)/$1
SRC = $2

ifeq ($(debug),1)
	CXXFLAGS += -ggdb -O0
else
	CXXFLAGS += -O2
endif

all: $(TARGET) $(BUILD)

$(BUILD):
	mkdir -p $(BUILD)

$(TARGET): $(SRC) | $(BUILD)
	$(CXX) $(CXXFLAGS) -o $(TARGET) $(SRC)

clean:
	rm -rf $(BUILD)

.PHONY: all clean